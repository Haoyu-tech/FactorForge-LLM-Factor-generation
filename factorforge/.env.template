# =============================================================================
# QuantaAlpha 环境配置  —  复制本文件为 .env 后按需修改
#   cp .env.template .env   (WSL/Linux)   或   copy .env.template .env  (Windows)
# =============================================================================

# ---- 数据路径（相对项目根目录，首次可保持默认，下载数据后自动匹配）----
QLIB_DATA_DIR=./data/qlib/cn_data
QLIB_PROVIDER_URI=./data/qlib/cn_data
DATA_RESULTS_DIR=./data/results
CONDA_ENV_NAME=quantaalpha

# ---- LLM API（必填）----
# 兼容 OpenAI 协议的任意服务：官方 OpenAI / DeepSeek / 阿里 DashScope(通义) 等
OPENAI_API_KEY=在此填入你的APIKey
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REASONING_MODEL=deepseek-v3
CHAT_MODEL=deepseek-v3

# ---- Embedding（可选，RAG 用）----
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ---- 全局参数（一般无需改动）----
USE_LOCAL=True
MAX_RETRY=5
RETRY_WAIT_SECONDS=5
FACTOR_MINING_TIMEOUT=999999
CHAT_MAX_TOKENS=4000
CHAT_TEMPERATURE=0.7


# Market mode: us | cn
MARKET_MODE=us
DEFAULT_MARKET=sp500

# China A-share DuckDB mode
CN_DUCKDB_PATH=/mnt/e/A股数据库/AKshare交易/data/market.db
# Keep the generated multi-gigabyte Qlib store off the C:-backed WSL disk.
CN_QLIB_DATA_DIR=/mnt/e/A股数据库/AKshare交易/data/qlib_cn_market
CN_EXCLUDE_ST=true
CN_EXCLUDE_NEW_STOCKS=true
CN_NEW_STOCK_MIN_TRADING_DAYS=375

CN_EXCLUDE_CHINEXT=false

CN_EXCLUDE_STAR=false

CN_EXCLUDE_BSE=false
